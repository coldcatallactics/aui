#!/usr/bin/env bash
# Drive real turns offscreen against a separate world server and a scripted
# model: send, queue, approve a command, stop, steer, run a command and reopen
# the channel. The exercise needs no account and no network, and it does not
# use the world of the person. A display is needed to measure text.
#
# Set AUI_EXERCISE_SHOTS to a directory to keep pictures of the exercise. Set
# AUI_EXERCISE_KEEP to a directory to keep the state of the world if the
# exercise fails.

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=lightfast.sh
source "$root/script/lightfast.sh"
aui_build_bridge

# The SBCL of Autolith is found through the data directory of the person. Find
# it before the exercise gets its own directories.
# shellcheck source=autolith.sh
source "$root/script/autolith.sh"
if [[ -n "$autolith_sbcl" ]]; then
  export AUTOLITH_SBCL=$autolith_sbcl
fi

# The path is short, because the socket of the world server is placed beneath
# it. The path is physical, because the directories given to Autolith are
# resolved.
world=$(mktemp -d /tmp/aui-live.XXXXXX)
world=$(CDPATH= cd -P "$world" && pwd)
status=0
cleanup() {
  # The exercise stops the server itself. If the exercise died first, the server
  # is still running.
  if [[ $status -ne 0 && -r "$world/autolith-program" ]]; then
    IFS= read -r program < "$world/autolith-program" || program=
    if [[ -n "$program" && -x "$program" ]]; then
      "$program" stop >/dev/null 2>&1 || true
    fi
  fi
  if [[ $status -ne 0 && -n ${AUI_EXERCISE_KEEP:-} ]]; then
    mkdir -p "$AUI_EXERCISE_KEEP" && cp -R "$world/state" "$AUI_EXERCISE_KEEP/" 2>/dev/null || true
  fi
  rm -rf "$world"
}
trap cleanup EXIT

export AUI_EXERCISE_WORLD=$world
export XDG_DATA_HOME=$world/data XDG_STATE_HOME=$world/state XDG_CONFIG_HOME=$world/config
export CODEX_HOME=$world/no-codex GROK_HOME=$world/no-grok
mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CONFIG_HOME" "$CODEX_HOME" "$GROK_HOME"

"$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui))' \
  --load "$root/script/exercise-live.lisp" || status=$?
exit "$status"
