#!/usr/bin/env bash
# Install AUI for this user. Build AUI and unslop, and put the aui and unslop
# commands on the path. On macOS, also make an application that can be started
# from the Dock and from Spotlight.
#
# Requirements:
#   - Autolith, installed from a release or from source. The autolith command
#     must be on the path, or AUI_AUTOLITH_ROOT must be set to the release
#     directory or the checkout of Autolith.
#   - FLTK 1.4 with fltk-config
#   - a C++17 compiler
#   - Lightfast, checked out beside AUI

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

"$root/script/build"
"$root/script/build-unslop"

bin_home=${AUI_BIN_HOME:-$HOME/.local/bin}
mkdir -p "$bin_home"
ln -sfn "$root/bin/aui" "$bin_home/aui"
echo "Linked $bin_home/aui"
ln -sfn "$root/bin/unslop" "$bin_home/unslop"
echo "Linked $bin_home/unslop"
case ":$PATH:" in
  *":$bin_home:"*) ;;
  *) echo "Add $bin_home to your PATH to run aui from a terminal." ;;
esac

if [[ $(uname -s) == Darwin ]]; then
  application=${AUI_APPLICATION:-$HOME/Applications/Autolith.app}
  mkdir -p "$application/Contents/MacOS" "$application/Contents/Resources"
  cat > "$application/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Autolith</string>
  <key>CFBundleDisplayName</key><string>Autolith</string>
  <key>CFBundleIdentifier</key><string>com.lambda-symbolics.aui</string>
  <key>CFBundleExecutable</key><string>Autolith</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
</dict>
</plist>
PLIST
  # Applications started from the Dock get a bare PATH and start in the root
  # directory. Add the usual tool directories to PATH, start in the home
  # directory, and let the person pick the channel.
  cat > "$application/Contents/MacOS/Autolith" <<LAUNCHER
#!/bin/bash
export PATH="\$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH"
cd "\$HOME"
exec "$root/bin/aui" open
LAUNCHER
  chmod +x "$application/Contents/MacOS/Autolith"
  # Make the icon of the application in the sizes used by the Dock.
  if command -v sips >/dev/null 2>&1 && command -v iconutil >/dev/null 2>&1; then
    iconset=$(mktemp -d)/Autolith.iconset
    mkdir -p "$iconset"
    for size in 16 32 128 256 512; do
      sips -z "$size" "$size" "$root/assets/icon.png" --out "$iconset/icon_${size}x${size}.png" >/dev/null
      sips -z "$((size * 2))" "$((size * 2))" "$root/assets/icon.png" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    if iconutil -c icns "$iconset" -o "$application/Contents/Resources/Autolith.icns"; then
      /usr/libexec/PlistBuddy -c "Add :CFBundleIconFile string Autolith" "$application/Contents/Info.plist" >/dev/null 2>&1 || true
    fi
    rm -rf "$(dirname "$iconset")"
  fi
  echo "Installed $application"
fi
