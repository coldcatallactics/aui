#!/usr/bin/env bash
# Start AUI from source: script/run [aui arguments]. Builds Lightfast's native
# bridge first when it is stale. bin/aui starts the saved image instead.

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
lightfast=${AUI_LIGHTFAST_ROOT:-$root/../lightfast}
make -s -C "$lightfast" native
exec "$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui))' \
  --eval '(aui:main)' \
  --end-toplevel-options "$@"
