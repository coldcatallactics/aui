#!/usr/bin/env bash
# Start AUI. The saved image is built on the first start. It is built again if
# the sources of AUI or of the Lightfast bridge are newer than the image, or if
# the image was built against another Autolith than the one on the path.

set -euo pipefail
path=${BASH_SOURCE[0]}
while [[ -L "$path" ]]; do
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd)
  path=$(readlink "$path")
  [[ $path == /* ]] || path=$directory/$path
done
root=$(CDPATH= cd -P "$(dirname "$path")/.." && pwd)
image=$root/build/aui
lightfast=${AUI_LIGHTFAST_ROOT:-$root/../lightfast}

# A failed build is only tried again if something changes after the failure.
failed=$root/build/failed
reference=$image
tried=
if [[ -x "$image" && -f "$failed" && "$failed" -nt "$image" ]]; then
  reference=$failed
  IFS= read -r tried < "$failed" || true
fi

stale=false
if [[ ! -x "$image" ]]; then
  stale=true
elif [[ -n $(find "$root/src" "$root/aui.asd" "$lightfast/src" "$lightfast/native" -newer "$reference" -print 2>/dev/null | head -n 1) ]]; then
  stale=true
elif [[ -z ${AUI_AUTOLITH_ROOT:-} ]]; then
  # If Autolith was updated after the build, the protocol in the image can be
  # older. An updated release is a new directory that contains old files. For
  # this reason, the image is compared with the Autolith on the path by name and
  # version, and not by age.
  # shellcheck source=../script/autolith.sh
  source "$root/script/autolith.sh"
  built=
  if [[ -r "$root/build/autolith" ]]; then
    IFS= read -r built < "$root/build/autolith" || true
  fi
  if [[ -n "$autolith_identity" && "$autolith_identity" != "$built" && "$autolith_identity" != "$tried" ]]; then
    stale=true
  fi
fi
if [[ $stale == true ]]; then
  echo "Building AUI. The first build takes a minute." >&2
  if ! "$root/script/build" >&2; then
    if [[ -x "$image" ]]; then
      echo "The build failed. Starting the last image that was built." >&2
    else
      exit 1
    fi
  fi
fi
exec "$image" "$@"
