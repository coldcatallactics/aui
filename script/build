#!/usr/bin/env bash
# Build Lightfast's native bridge and the saved AUI image.

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=lightfast.sh
source "$root/script/lightfast.sh"

aui_require_lightfast
mkdir -p "$root/build"
# shellcheck source=autolith.sh
source "$root/script/autolith.sh"
# Record the Autolith used by this attempt so bin/aui can avoid repeating a failed build.
printf '%s\n' "$autolith_identity" > "$root/build/failed"
aui_build_bridge
# Save beside the current image, then replace it only after a successful build.
rm -f "$root/build/aui.new"
"$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui))' \
  >"$root/build/build.log" 2>&1 || { tail -40 "$root/build/build.log" >&2; exit 1; }
AUI_HEAP=1GB "$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui))' \
  --eval '(aui::save-image (uiop:native-namestring (merge-pathnames "build/aui.new" (asdf:system-source-directory :aui))))' \
  >>"$root/build/build.log" 2>&1 || { tail -40 "$root/build/build.log" >&2; exit 1; }
if [[ ! -x "$root/build/aui.new" ]]; then
  tail -40 "$root/build/build.log" >&2
  echo "The image was not saved." >&2
  exit 1
fi
mv -f "$root/build/aui.new" "$root/build/aui"
# Record the Autolith in the image. If another Autolith is installed, the image
# is built again by bin/aui.
printf '%s\n' "$autolith_identity" > "$root/build/autolith"
rm -f "$root/build/failed"
echo "Built $root/build/aui"
