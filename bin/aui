#!/usr/bin/env bash

set -euo pipefail
path=${BASH_SOURCE[0]}
while [[ -L "$path" ]]; do
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd)
  path=$(readlink "$path")
  [[ $path == /* ]] || path=$directory/$path
done
root=$(CDPATH= cd -P "$(dirname "$path")/.." && pwd)
image=$root/build/aui
lightfast=${AUI_LIGHTFAST_ROOT:-$root/../lightfast}

# Retry a failed build only after its inputs change.
failed=$root/build/failed
reference=$image
tried=
if [[ -x "$image" && -f "$failed" && "$failed" -nt "$image" ]]; then
  reference=$failed
  IFS= read -r tried < "$failed" || true
fi

stale=false
if [[ ! -x "$image" ]]; then
  stale=true
elif [[ -n $(find "$root/src" "$root/aui.asd" "$lightfast/src" "$lightfast/native" -newer "$reference" -print 2>/dev/null | head -n 1) ]]; then
  stale=true
elif [[ -z ${AUI_AUTOLITH_ROOT:-} ]]; then
  # Files from a newly installed release can predate the image.
  # shellcheck source=../script/autolith.sh
  source "$root/script/autolith.sh"
  built=
  if [[ -r "$root/build/autolith" ]]; then
    IFS= read -r built < "$root/build/autolith" || true
  fi
  if [[ -n "$autolith_identity" && "$autolith_identity" != "$built" && "$autolith_identity" != "$tried" ]]; then
    stale=true
  fi
fi
if [[ $stale == true ]]; then
  echo "Building AUI..." >&2
  if ! "$root/script/build" >&2; then
    if [[ -x "$image" ]]; then
      echo "Build failed. Starting the previous image." >&2
    else
      exit 1
    fi
  fi
fi
exec "$image" "$@"
