#!/usr/bin/env bash
# Build AUI: Lightfast's native bridge, then the saved image build/aui that
# bin/aui starts. Run it again after updating AUI, Lightfast or Autolith.
# Autolith is the release or the checkout that script/autolith.sh finds.

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=lightfast.sh
source "$root/script/lightfast.sh"

aui_require_lightfast
mkdir -p "$root/build"
# shellcheck source=autolith.sh
source "$root/script/autolith.sh"
# The mark of a build that did not finish, naming the Autolith it was tried
# against; bin/aui reads it so that it does not try the same sources again on
# every start.
printf '%s\n' "$autolith_identity" > "$root/build/failed"
aui_build_bridge
# The image is saved beside the one in use and moved over it only once it
# exists, so a build that fails leaves the last good image in place.
rm -f "$root/build/aui.new"
# Everything is compiled first, in a large heap. The image is then saved from
# a process with a small one, because an image keeps the size of the heap it
# was saved with, and the tables SBCL keeps for a heap it will never fill
# would cost a window some fifteen megabytes.
"$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui))' \
  >"$root/build/build.log" 2>&1 || { tail -40 "$root/build/build.log" >&2; exit 1; }
AUI_HEAP=1GB "$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui))' \
  --eval '(aui::save-image (uiop:native-namestring (merge-pathnames "build/aui.new" (asdf:system-source-directory :aui))))' \
  >>"$root/build/build.log" 2>&1 || { tail -40 "$root/build/build.log" >&2; exit 1; }
if [[ ! -x "$root/build/aui.new" ]]; then
  tail -40 "$root/build/build.log" >&2
  echo "The image was not saved." >&2
  exit 1
fi
mv -f "$root/build/aui.new" "$root/build/aui"
# Which Autolith the image holds; bin/aui builds again when another is installed.
printf '%s\n' "$autolith_identity" > "$root/build/autolith"
rm -f "$root/build/failed"
echo "Built $root/build/aui"
