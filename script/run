#!/usr/bin/env bash
# Run AUI from source after building the native bridge.

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=lightfast.sh
source "$root/script/lightfast.sh"
aui_build_bridge
exec "$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui))' \
  --eval '(aui:main)' \
  --end-toplevel-options "$@"
