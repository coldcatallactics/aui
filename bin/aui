#!/usr/bin/env bash
# Start AUI. The saved image is built on first use and again whenever AUI's
# sources or Lightfast's bridge are newer, or the Autolith on the path is not
# the one it was built against.

set -euo pipefail
path=${BASH_SOURCE[0]}
while [[ -L "$path" ]]; do
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd)
  path=$(readlink "$path")
  [[ $path == /* ]] || path=$directory/$path
done
root=$(CDPATH= cd -P "$(dirname "$path")/.." && pwd)
image=$root/build/aui
lightfast=${AUI_LIGHTFAST_ROOT:-$root/../lightfast}

# A build that failed is not tried again until something changes after it.
failed=$root/build/failed
reference=$image
tried=
if [[ -x "$image" && -f "$failed" && "$failed" -nt "$image" ]]; then
  reference=$failed
  IFS= read -r tried < "$failed" || true
fi

stale=false
if [[ ! -x "$image" ]]; then
  stale=true
elif [[ -n $(find "$root/src" "$root/aui.asd" "$lightfast/src" "$lightfast/native" -newer "$reference" -print 2>/dev/null | head -n 1) ]]; then
  stale=true
elif [[ -z ${AUI_AUTOLITH_ROOT:-} ]]; then
  # An Autolith updated since the build speaks a newer protocol than the image
  # holds. An updated release is a new directory with old files in it, so the
  # image is compared with the Autolith on the path by name and version, not
  # by age.
  # shellcheck source=../script/autolith.sh
  source "$root/script/autolith.sh"
  built=
  if [[ -r "$root/build/autolith" ]]; then
    IFS= read -r built < "$root/build/autolith" || true
  fi
  if [[ -n "$autolith_identity" && "$autolith_identity" != "$built" && "$autolith_identity" != "$tried" ]]; then
    stale=true
  fi
fi
if [[ $stale == true ]]; then
  echo "Building AUI; this takes a minute the first time." >&2
  if ! "$root/script/build" >&2; then
    if [[ -x "$image" ]]; then
      echo "The build failed; starting the last image that built." >&2
    else
      exit 1
    fi
  fi
fi
exec "$image" "$@"
