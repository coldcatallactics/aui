#!/usr/bin/env bash
# Build the native bridge and the saved unslop image.

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=lightfast.sh
source "$root/script/lightfast.sh"

aui_require_lightfast
mkdir -p "$root/build"
aui_build_bridge
# Save beside the current image, then replace it only after a successful build.
rm -f "$root/build/unslop.new"
AUI_HEAP=1GB "$root/script/lisp" \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system :aui/unslop))' \
  --eval '(aui::unslop-save-image (uiop:native-namestring (merge-pathnames "build/unslop.new" (asdf:system-source-directory :aui/unslop))))' \
  >"$root/build/unslop.log" 2>&1 || { tail -40 "$root/build/unslop.log" >&2; exit 1; }
if [[ ! -x "$root/build/unslop.new" ]]; then
  tail -40 "$root/build/unslop.log" >&2
  echo "The image was not saved." >&2
  exit 1
fi
mv -f "$root/build/unslop.new" "$root/build/unslop"
echo "Built $root/build/unslop"
