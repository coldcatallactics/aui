#!/usr/bin/env bash
# Usage: script/lisp [SBCL options]. Set AUI_HEAP to override the build heap size.

set -euo pipefail
root=$(CDPATH= cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=autolith.sh
source "$root/script/autolith.sh"
sbcl=$autolith_sbcl
if [[ -z "$sbcl" ]]; then
  sbcl=$(command -v sbcl) || { echo "AUI needs SBCL. Install Autolith first." >&2; exit 64; }
fi
if [[ -n "$autolith_source" ]]; then
  export AUI_AUTOLITH_ROOT=$autolith_source
fi

exec "$sbcl" --noinform --dynamic-space-size "${AUI_HEAP:-4GB}" --non-interactive \
  --eval '(handler-bind ((warning (function muffle-warning))) (load "'"$root"'/script/setup.lisp"))' \
  "$@"
