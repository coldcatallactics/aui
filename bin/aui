#!/usr/bin/env bash

set -euo pipefail
path=${BASH_SOURCE[0]}
while [[ -L "$path" ]]; do
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd)
  path=$(readlink "$path")
  [[ $path == /* ]] || path=$directory/$path
done
root=$(CDPATH= cd -P "$(dirname "$path")/.." && pwd)
image=$root/build/aui
lightfast=${AUI_LIGHTFAST_ROOT:-$root/../lightfast}

# Retry a failed build only after its inputs change.
failed=$root/build/failed
reference=$image
tried=
if [[ -x "$image" && -f "$failed" && "$failed" -nt "$image" ]]; then
  reference=$failed
  IFS= read -r tried < "$failed" || true
fi

# A live client restarts the server with the launcher captured in its image.
# Never fall back to an image for another installation or source revision.
# shellcheck source=../script/autolith.sh
source "$root/script/autolith.sh"
built=
if [[ -r "$root/build/autolith" ]]; then
  IFS= read -r built < "$root/build/autolith" || true
fi
mismatch=false
if [[ -n "$autolith_identity" && "$autolith_identity" != "$built" ]]; then mismatch=true; fi
stale=false
if [[ ! -x "$image" ]]; then
  stale=true
elif [[ -n $(find "$root/src" "$root/aui.asd" "$lightfast/src" "$lightfast/native" -newer "$reference" -print 2>/dev/null | head -n 1) ]]; then
  stale=true
elif [[ $mismatch == true && "$autolith_identity" != "$tried" ]]; then
  stale=true
fi
if [[ $stale == true ]]; then
  echo "Building AUI..." >&2
  if ! "$root/script/build" >&2; then
    if [[ ! -x "$image" || $mismatch == true ]]; then exit 1; fi
    echo "Build failed. Starting the previous image." >&2
  fi
fi
if [[ $stale == false && $mismatch == true ]]; then
  echo "The last AUI build for $autolith_identity failed. See $root/build/build.log." >&2
  exit 1
fi
exec "$image" "$@"
