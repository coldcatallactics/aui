#!/usr/bin/env bash
# Start AUI. The saved image is built on first use and again whenever AUI's
# sources, Lightfast's bridge or the Autolith it was built against are newer.

set -euo pipefail
path=${BASH_SOURCE[0]}
while [[ -L "$path" ]]; do
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd)
  path=$(readlink "$path")
  [[ $path == /* ]] || path=$directory/$path
done
root=$(CDPATH= cd -P "$(dirname "$path")/.." && pwd)
image=$root/build/aui
lightfast=${AUI_LIGHTFAST_ROOT:-$root/../lightfast}

# A build that failed is not tried again until something changes after it.
failed=$root/build/failed
reference=$image
if [[ -x "$image" && -f "$failed" && "$failed" -nt "$image" ]]; then
  reference=$failed
fi

stale=false
if [[ ! -x "$image" ]]; then
  stale=true
elif [[ -n $(find "$root/src" "$root/aui.asd" "$lightfast/src" "$lightfast/native" -newer "$reference" -print -quit 2>/dev/null) ]]; then
  stale=true
elif autolith=$(command -v autolith 2>/dev/null); then
  # An Autolith updated since the build speaks a newer protocol than the image holds.
  while [[ -L "$autolith" ]]; do
    directory=$(CDPATH= cd -P "$(dirname "$autolith")" && pwd)
    autolith=$(readlink "$autolith")
    [[ $autolith == /* ]] || autolith=$directory/$autolith
  done
  version=$(dirname "$(dirname "$autolith")")/VERSION
  if [[ -f "$version" && "$version" -nt "$reference" && -z ${AUI_AUTOLITH_ROOT:-} ]]; then
    stale=true
  fi
fi
if [[ $stale == true ]]; then
  echo "Building AUI; this takes a minute the first time." >&2
  if ! "$root/script/build" >&2; then
    if [[ -x "$image" ]]; then
      echo "The build failed; starting the last image that built." >&2
    else
      exit 1
    fi
  fi
fi
exec "$image" "$@"
